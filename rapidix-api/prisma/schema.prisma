// Esquema de datos de Rapidix — SPEC 01
//
// Los nombres de campo se toman del prototipo (`rapidix_mockup (2).html`)
// para que el porte de la logica de negocio sea literal.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Identidad y clientes
// ============================================================

enum RolUsuario {
  ADMINISTRADOR
  RUTA
  OPERACIONES
  FINANZAS
}

/// Personal del negocio. Nunca clientes: esos viven en `Cliente`.
model Usuario {
  id            String     @id @default(uuid())
  email         String     @unique
  passwordHash  String
  nombre        String
  rol           RolUsuario
  activo        Boolean    @default(true)
  creadoEn      DateTime   @default(now())
  actualizadoEn DateTime   @updatedAt

  // Rutas. Solo las llena quien reparte; el resto del personal las deja vacias.
  sesiones        SesionEntrega[]
  cargas          CargaRepartidor[]
  pedidos         Pedido[]
  entregas        EntregaPedido[]
  cortes          Corte[]           @relation("CortesDelRepartidor")
  cortesRecibidos Corte[]           @relation("CortesRecibidos")
  abonos          CorteAbono[]

  @@map("usuarios")
}

model Cliente {
  id              String    @id @default(uuid())
  nombre          String
  email           String?
  /// WhatsApp. Es el identificador de login del cliente (HU-C02).
  telefono        String    @unique
  fechaNacimiento DateTime?
  quienRecibe     String?

  // Direccion de envio
  calle       String?
  colonia     String?
  cp          String?
  ciudad      String?
  estado      String?
  referencias String?
  lat         Float?
  lng         Float?

  /// Sucursal a la que pertenece el cliente. Se usa para segmentar campanias
  /// (Word 4.9.3); es texto libre porque el negocio todavia no tiene un
  /// catalogo de sucursales.
  sucursal String?

  /// Codigo de la fuente de adquisicion, capturado del enlace rapidix.mx/r/CODIGO.
  fuenteCodigo   String?
  notificaciones Boolean @default(true)

  // Fidelizacion
  saldoCashback Decimal         @default(0) @db.Decimal(12, 2)
  nivelId       String?
  nivel         NivelFidelidad? @relation(fields: [nivelId], references: [id])
  /// Bono manual en puntos porcentuales que se suma al % de su nivel (HU-12).
  /// Lo edita el dueno directo en la base; el codigo lo lee y nunca lo pisa.
  pctExtra      Decimal         @default(0) @db.Decimal(5, 2)

  /// Carrito a medias, sincronizado desde la Tienda (HU-13).
  ///
  /// `[{ productoId, cantidad }]`, nunca precios: es el mismo contenido que
  /// viaja a `POST /carrito/previsualizar`, para que un carrito guardado hoy y
  /// recuperado la semana que viene se valore con los precios de entonces.
  /// Sirve para que la compra a medias siga ahi al cambiar de telefono.
  carrito      Json?
  carritoEn    DateTime?
  /// Borrador de la entrega del checkout: `{ metodoEntrega, direccion }`.
  ///
  /// Es la direccion de ESTE pedido, no la del perfil: puede ser la casa de un
  /// familiar. Se respalda junto al carrito para no perderla si el navegador
  /// borra su almacenamiento, y se borra con el al confirmar el pedido.
  borradorEntrega Json?

  // Contadores derivados de Pedido, mantenidos dentro de la transaccion de pedido
  pedidos      Int       @default(0)
  totalGastado Decimal   @default(0) @db.Decimal(12, 2)
  primerPedido DateTime?
  ultimoPedido DateTime?

  creado        DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  solicitudes       SolicitudProducto[]
  recetasCreadas    Receta[]
  recetasGuardadas  RecetaGuardada[]
  recetaPausada     RecetaPausada?
  recetasCocinadas  RecetaCocinada[]
  calificaciones    RecetaCalificacion[]
  ordenes           Pedido[]
  cupones           CuponEmitido[]
  movimientos       MovimientoCashback[]
  lecturaDestacados LecturaDestacados?

  @@index([ultimoPedido])
  @@index([ciudad])
  @@map("clientes")
}

/// Quien entro por WhatsApp y dio su nombre, pero todavia no ha comprado.
///
/// Es cliente el que hace un pedido, no el que se registra: hasta entonces el
/// registro vive aqui y no en `clientes`, que es la tabla oficial del negocio
/// y la que cuenta para metricas, campanias y segmentacion.
///
/// Al confirmar su primer pedido la fila se convierte: se crea el `Cliente`,
/// sus cupones cambian de dueno y esta se borra. Por eso un telefono nunca
/// esta en las dos tablas a la vez, y `telefono` es unico en ambas.
model Prospecto {
  id       String @id @default(uuid())
  nombre   String
  /// WhatsApp. Mismo identificador de login que en `clientes`.
  telefono String @unique

  /// Los mismos campos que edita "Mi Perfil", repetidos aqui a proposito.
  ///
  /// Sin ellos un prospecto no podria dar su direccion antes de comprar, y su
  /// primer pedido llegaria sin donde entregarlo. Al convertirse se copian
  /// tal cual al `Cliente`, asi que lo que escribio no se pierde.
  email           String?
  fechaNacimiento DateTime?
  quienRecibe     String?
  sucursal        String?

  calle       String?
  colonia     String?
  cp          String?
  ciudad      String?
  estado      String?
  referencias String?
  lat         Float?
  lng         Float?

  notificaciones Boolean @default(true)

  /// Mismo carrito sincronizado que en `clientes`, por la misma razon por la
  /// que se repite la direccion: quien todavia no ha comprado es justo el que
  /// esta armando su primer carrito, y no puede perderlo por no ser cliente.
  /// Al convertirse se copia tal cual.
  carrito         Json?
  carritoEn       DateTime?
  /// Mismo borrador de entrega que en `clientes`.
  borradorEntrega Json?

  /// Codigo de la fuente de adquisicion, capturado del enlace rapidix.mx/r/CODIGO.
  /// Viaja al cliente al convertirse: la atribucion es del registro, no de la compra.
  fuenteCodigo String?

  creado        DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  cupones CuponEmitido[]

  @@index([creado])
  @@map("prospectos")
}

/// Codigos de un solo uso para el login del cliente por WhatsApp.
model CodigoOtp {
  id          String    @id @default(uuid())
  telefono    String
  codigoHash  String
  expiraEn    DateTime
  intentos    Int       @default(0)
  consumidoEn DateTime?
  creadoEn    DateTime  @default(now())

  @@index([telefono, expiraEn])
  @@map("codigos_otp")
}

// ============================================================
// Catalogo
// ============================================================

/// Catalogo de categorias de producto. No se administra a mano: cada alta o
/// importacion que nombra una categoria nueva la da de alta aqui, y la
/// categoria sobrevive aunque se quede sin productos, porque las campanias de
/// cupones restringen por ella (Word 4.9.3).
model Categoria {
  id     String @id @default(uuid())
  nombre String @unique

  /// Orden de la familia en la Tienda: 1 es la primera fila.
  ///
  /// Es lo que decide el negocio, no la alfabetica: Carnes antes que Abarrotes
  /// aunque la A vaya antes que la C. Las categorias que nadie ha priorizado
  /// nacen en 99 y caen al final, ordenadas entre ellas por nombre.
  prioridad Int @default(99)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  productos Producto[]

  @@index([prioridad])
  @@map("categorias")
}

/// Que papel juega el producto en la compra. Desempata dentro de su familia
/// cuando el cliente no tiene historial que diga otra cosa.
enum RolProducto {
  /// Por lo que se viene a la tienda. Va primero.
  DESTINO
  /// Lo que se repone cada semana.
  RUTINA
  /// Solo tiene sentido parte del ano.
  ESTACIONAL
  /// Lo que se anade sobre la marcha. Va al final.
  CONVENIENCIA
}

model Producto {
  id String @id @default(uuid())

  nombre      String
  categoriaId String
  categoria   Categoria @relation(fields: [categoriaId], references: [id])
  unidad      String
  precioCosto Decimal @db.Decimal(12, 2)
  precioVenta Decimal @db.Decimal(12, 2)
  imagenUrl   String?
  agotado     Boolean @default(false)

  /// Papel del producto dentro de su familia (HU-01). Nace en RUTINA: es el
  /// caso normal, y asi un producto recien dado de alta no adelanta a los que
  /// el negocio si clasifico como destino.
  rol RolProducto @default(RUTINA)

  /// Lo que hay fisicamente en bodega.
  inventario    Int @default(0)
  /// Lo liberado para venta: es lo que el cliente puede comprar.
  ///
  /// No tiene por que coincidir con `inventario`. Mercancia en cuarentena ya
  /// llego a la bodega —suma al fisico— pero todavia no se puede vender.
  aptInventario Int @default(0)

  /// Precio escalonado (HU-08). `precioVenta` es la lista 1 y vale desde la
  /// primera pieza; `piso2`/`precio2` y `piso3`/`precio3` son las listas 2 y 3:
  /// a partir de `piso` piezas, la linea entera se cobra a `precio`.
  ///
  /// No hay tope superior a proposito: el techo de una lista es el piso de la
  /// siguiente, y pasar el piso de la ultima conserva su precio. Asi no pueden
  /// quedar huecos entre rangos. Pares completos, pisos que suben y precios
  /// que bajan los garantizan los CHECK de la migracion.
  piso2   Int?
  precio2 Decimal? @db.Decimal(12, 2)
  piso3   Int?
  precio3 Decimal? @db.Decimal(12, 2)

  /// Si el producto suma a la base del cashback (HU-12). Nace encendido: lo
  /// normal es que todo participe y se excluye lo que no deja margen.
  aplicaCashback Boolean @default(true)

  /// Borrado logico. Un producto que ya aparece en pedidos no puede salir de
  /// la tabla —las lineas lo referencian—, asi que "eliminarlo" es poner esta
  /// fecha: desaparece de la Tienda, del panel, del inventario y del carrito,
  /// pero el historial sigue apuntando a una fila que existe. Nulo = vivo.
  eliminadoEn DateTime?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  solicitudes SolicitudProducto[]
  lineas      PedidoItem[]
  movimientos MovimientoInventario[]
  cargas      CargaRepartidor[]

  @@index([categoriaId])
  @@map("productos")
}

/// Boton "Programar" de un producto agotado: intencion de compra futura.
model SolicitudProducto {
  id         String   @id @default(uuid())
  clienteId  String
  cliente    Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  productoId String
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  creadoEn   DateTime @default(now())

  @@index([productoId])
  @@index([clienteId])
  @@map("solicitudes_producto")
}

/// Entrada o salida de bodega.
enum TipoMovimiento {
  ENTRADA
  SALIDA
}

/// Cual de los dos saldos toca el movimiento.
enum AfectaInventario {
  /// Lo normal: la mercancia entra o sale de verdad.
  AMBOS
  /// Llego a bodega pero no se libera a venta (cuarentena).
  FISICO
  /// Se aparta o se libera lo que ya esta en piso; el fisico no se mueve.
  APT
}

/// Por que se movio. Es un catalogo cerrado a proposito: con texto libre no se
/// puede agrupar por causa, que es justo lo que se le pide a la bitacora.
enum MotivoMovimiento {
  COMPRA
  VENTA
  MERMA
  TRASPASO
  AJUSTE
  DEVOLUCION
}

/// Bitacora de bodega. Nadie pisa el saldo de un producto: lo suma o lo resta
/// y deja aqui su renglon.
///
/// Cada fila congela los cuatro saldos (antes/despues x fisico/apt) del
/// instante en que se aplico. Se explica sola aunque alguien haya movido el
/// mismo producto un segundo despues, y sin eso el historial habria que
/// recalcularlo hacia atras cada vez que se consulta.
model MovimientoInventario {
  id         String   @id @default(uuid())
  productoId String
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  tipo     TipoMovimiento
  afecta   AfectaInventario
  motivo   MotivoMovimiento
  /// Siempre positiva. El signo lo pone `tipo`.
  cantidad Int

  /// Quien movio la mercancia. Texto libre y no siempre es quien esta
  /// logueado: el de la sesion se guarda aparte en `usuarioId`.
  empleado      String
  observaciones String?

  /// Usuario de la sesion que registro el movimiento. Null cuando lo genera
  /// una venta, porque ahi quien descuenta es el pedido, no una persona.
  usuarioId     String?
  usuarioNombre String?
  /// Pedido que lo genero, cuando es la salida por venta.
  pedidoId      String?

  fisicoAntes   Int
  fisicoDespues Int
  aptAntes      Int
  aptDespues    Int

  creadoEn DateTime @default(now())

  @@index([productoId, creadoEn])
  @@index([creadoEn])
  @@index([pedidoId])
  @@map("movimientos_inventario")
}

// ============================================================
// Imagenes
// ============================================================

/// Imagen guardada dentro de la propia base de datos.
///
/// El camino preferente sigue siendo S3: el navegador sube directo al bucket y
/// `imagenUrl` apunta alli. Pero sin las variables `S3_*` no habria subida
/// ninguna, y el negocio no puede quedarse sin fotos de producto por no tener
/// contratado un bucket. Entonces la API hace de almacen: guarda los bytes en
/// esta tabla y los sirve por `GET /uploads/local/:id`.
///
/// Es un almacen acotado a proposito —una foto por producto o receta, 5 MB de
/// tope y solo dos carpetas—, no un sistema de ficheros general. Con muchas
/// imagenes grandes conviene mover el entorno a S3, que es para lo que sigue
/// existiendo la otra rama.
model Imagen {
  id String @id @default(uuid())

  /// 'productos' o 'recetas': la misma particion que las carpetas del bucket.
  carpeta     String
  contentType String
  tamanoBytes Int
  /// En Postgres es un `bytea`. Se sirve tal cual, sin recodificar.
  datos       Bytes

  creadoEn DateTime @default(now())

  @@index([creadoEn])
  @@map("imagenes")
}

// ============================================================
// Recetario
// ============================================================

enum OrigenReceta {
  RECETARIO
  PROPIA
  COMUNIDAD
}

model Receta {
  id         String   @id @default(uuid())
  nombre     String
  tiempo     String
  porciones  Int
  imagenUrl  String?
  emoji      String?
  youtube    String?
  /// 'desayuno' | 'comida' | 'cena'
  categorias String[]

  autorNombre    String
  /// Null en las recetas oficiales del Recetario.
  autorClienteId String?
  autor          Cliente? @relation(fields: [autorClienteId], references: [id], onDelete: SetNull)

  origin    OrigenReceta
  compartir Boolean      @default(false)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  ingredientes   RecetaIngrediente[]
  pasos          RecetaPaso[]
  guardadaPor    RecetaGuardada[]
  pausadaPor     RecetaPausada[]
  cocinadaPor    RecetaCocinada[]
  calificaciones RecetaCalificacion[]

  @@index([origin])
  @@index([autorClienteId])
  @@map("recetas")
}

model RecetaIngrediente {
  id       String @id @default(uuid())
  recetaId String
  receta   Receta @relation(fields: [recetaId], references: [id], onDelete: Cascade)
  nombre   String
  cantidad String
  orden    Int

  @@index([recetaId])
  @@map("receta_ingredientes")
}

model RecetaPaso {
  id       String @id @default(uuid())
  recetaId String
  receta   Receta @relation(fields: [recetaId], references: [id], onDelete: Cascade)
  texto    String
  orden    Int

  @@index([recetaId])
  @@map("receta_pasos")
}

/// "Mis Recetas": recetas ajenas que el cliente guardo.
model RecetaGuardada {
  clienteId String
  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  recetaId  String
  receta    Receta   @relation(fields: [recetaId], references: [id], onDelete: Cascade)
  creadoEn  DateTime @default(now())

  @@id([clienteId, recetaId])
  @@map("recetas_guardadas")
}

/// Receta en pausa. `clienteId` es la clave primaria: por esquema, solo puede
/// haber una receta pausada por cliente a la vez (Word 6.4).
model RecetaPausada {
  clienteId String   @id
  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  recetaId  String
  receta    Receta   @relation(fields: [recetaId], references: [id], onDelete: Cascade)
  pausadaEn DateTime @default(now())

  @@map("recetas_pausadas")
}

/// Evento "!Listo a comer!". Alimenta el Historial de los ultimos 35 dias
/// y es requisito previo para poder calificar.
model RecetaCocinada {
  id         String   @id @default(uuid())
  clienteId  String
  cliente    Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  recetaId   String
  receta     Receta   @relation(fields: [recetaId], references: [id], onDelete: Cascade)
  cocinadaEn DateTime @default(now())

  @@index([clienteId, cocinadaEn])
  @@map("recetas_cocinadas")
}

model RecetaCalificacion {
  clienteId  String
  cliente    Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  recetaId   String
  receta     Receta   @relation(fields: [recetaId], references: [id], onDelete: Cascade)
  puntuacion Int
  creadoEn   DateTime @default(now())

  @@id([clienteId, recetaId])
  @@index([recetaId])
  @@map("recetas_calificaciones")
}

// ============================================================
// Pedidos
// ============================================================

/// Donde esta fisicamente la mercancia. Avanza de un paso en un paso: lo mueven
/// Operaciones (hasta LISTO_PARA_ENTREGA, o ENTREGADO si se recoge en tienda) y
/// Rutas (RECOLECTADO, EN_RUTA, ENTREGADO a domicilio).
///
/// No hay CANCELADO: cancelar es una decision sobre el dinero y vive en
/// `EstadoPago`. Aqui se conserva donde se quedo la caja, que es lo que decide
/// que inventario regresa.
enum EstadoPedido {
  CONFIRMADO
  EN_PREPARACION
  PREPARADO
  LISTO_PARA_ENTREGA
  RECOLECTADO
  EN_RUTA
  ENTREGADO
}

/// Como se cobra lo que queda despues del cupon y de la billetera. La
/// billetera no es un metodo: se combina con cualquiera de los dos (HU-12).
enum MetodoPago {
  EFECTIVO
  TRANSFERENCIA
}

/// Lo que Finanzas decidio sobre el dinero, independiente del avance fisico.
///
/// Solo RETENER frena el avance; lo demas deja llegar hasta la puerta. Entregar
/// pide ademas el pago cubierto (`pagoCubierto` en `flujo.ts`). Ya no existe
/// LIBERAR: el pago pendiente deja avanzar por si solo.
enum EstadoPago {
  /// Estado inicial de todo pedido con algo por cobrar. Deja avanzar; el efectivo
  /// se entrega y se cobra en la puerta, la transferencia espera a PAGADO.
  PAGO_PENDIENTE
  /// Congela todo el avance fisico, incluso la preparacion.
  RETENER
  /// Finanzas autoriza entregar sin cobrar: el cliente paga despues.
  CREDITO
  /// Solo etiqueta: no mueve dinero por si mismo.
  REEMBOLSADO
  /// Dinero confirmado, o pedido cubierto entero con la billetera. Acredita el cashback.
  PAGADO
  /// Terminal. Devuelve inventario y el saldo de billetera usado.
  CANCELADO
}

/// Que eje cambio en un renglon de la bitacora.
enum EjeBitacora {
  PEDIDO
  PAGO
}

/// Quien provoco el cambio.
enum ActorBitacora {
  CLIENTE
  PERSONAL
  SISTEMA
}

/// Como llega el pedido al cliente. Recoger en tienda no paga envio.
enum MetodoEntrega {
  DOMICILIO
  TIENDA
}

model Pedido {
  id        String  @id @default(uuid())
  folio     String  @unique
  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id])

  subtotal     Decimal @db.Decimal(12, 2)
  envio        Decimal @db.Decimal(12, 2)
  /// Recargo por atencion fuera de horario (Word 6.8). Columna propia para poder auditarlo.
  recargoFuera Decimal @default(0) @db.Decimal(12, 2)
  descuento    Decimal @default(0) @db.Decimal(12, 2)
  total        Decimal @db.Decimal(12, 2)

  // Pago (HU-09 a HU-12). `total` es lo que vale el pedido; lo que cobra el
  // repartidor o la transferencia es `total - pagadoConBilletera`.
  metodoPago         MetodoPago @default(EFECTIVO)
  estadoPago         EstadoPago @default(PAGO_PENDIENTE)
  /// Saldo de billetera aplicado. Sale de `clientes.saldoCashback` con su
  /// movimiento negativo dentro de la misma transaccion.
  pagadoConBilletera Decimal    @default(0) @db.Decimal(12, 2)
  /// Efectivo: con cuanto dijo que pagaria, para que el repartidor lleve cambio.
  pagoCon            Decimal?   @db.Decimal(12, 2)
  cambio             Decimal?   @db.Decimal(12, 2)
  pagoValidadoEn     DateTime?

  /// A domicilio paga envio; recogido en tienda no.
  metodoEntrega MetodoEntrega @default(DOMICILIO)

  // Rutas. `repartidorId` se toma solo: el primero que pulsa "Recolectado"
  // sobre un pedido libre se queda con el, y vuelve a null si regresa a bodega
  // al cerrar el corte.
  repartidorId String?
  repartidor   Usuario? @relation(fields: [repartidorId], references: [id])
  /// Ya entro a un corte como dinero entregado. Un pedido que solo regreso a
  /// bodega no se liquida: vuelve a salir.
  liquidado    Boolean   @default(false)
  liquidadoEn  DateTime?
  /// El primer corte en el que entro; no se sobrescribe si vuelve a salir.
  corteId      String?
  corte        Corte?    @relation(fields: [corteId], references: [id])

  /// Cashback que gana el pedido, ya con el multiplicador de la billetera. Se
  /// calcula y congela al crearlo, pero no entra a la billetera hasta que el
  /// pago queda PAGADO (`cashbackAcreditadoEn`): un pedido que se cancela antes
  /// no deja saldo regalado.
  cashbackGenerado     Decimal   @default(0) @db.Decimal(12, 2)
  /// % con el que se calculo (nivel + bono), congelado para poder recalcular el
  /// cashback si la entrega es parcial.
  porcentajeCashback   Decimal   @default(0) @db.Decimal(5, 2)
  cashbackAcreditadoEn DateTime?
  estado           EstadoPedido @default(CONFIRMADO)
  /// Snapshot de la direccion de envio al momento del pedido.
  direccion        Json

  creadoEn DateTime @default(now())

  items       PedidoItem[]
  /// Cupon canjeado en este pedido. Es 0 o 1: la regla "un cupon por pedido"
  /// la garantiza el @unique de CuponEmitido.usedPedidoId.
  cupon       CuponEmitido?
  movimientos MovimientoCashback[]
  bitacora    BitacoraPedido[]
  cargas      CargaRepartidor[]
  entrega     EntregaPedido?

  @@index([clienteId, creadoEn])
  @@index([repartidorId])
  @@map("pedidos")
}

/// Cada cambio de estado de un pedido, en cualquiera de sus dos ejes: quien,
/// cuando, de que a que y por que. Solo se escribe, nunca se edita.
///
/// Los estados van como texto porque la misma columna guarda valores de
/// `EstadoPedido` y de `EstadoPago`; `eje` dice de cual. `estadoAnterior` es
/// null en el renglon con el que nace el pedido.
///
/// El actor se congela con su nombre y sin llave foranea, igual que en
/// `movimientos_inventario`: puede ser un cliente, un usuario del personal o el
/// sistema, y la bitacora tiene que seguir legible aunque se borre la cuenta.
model BitacoraPedido {
  id       String @id @default(uuid())
  pedidoId String
  pedido   Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  eje            EjeBitacora
  estadoAnterior String?
  estadoNuevo    String
  /// Motivo de una cancelacion, de una retencion o cualquier aclaracion.
  nota           String?

  actor       ActorBitacora
  actorId     String?
  actorNombre String

  creadoEn DateTime @default(now())

  @@index([pedidoId, creadoEn])
  @@map("bitacora_pedidos")
}

model PedidoItem {
  id       String @id @default(uuid())
  pedidoId String
  pedido   Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  productoId String
  producto   Producto @relation(fields: [productoId], references: [id])

  // Snapshots: un cambio de precio o de categoria no reescribe la historia.
  nombre         String
  categoria      String
  unidad         String
  precioUnitario Decimal @db.Decimal(12, 2)
  cantidad       Int

  cargas CargaRepartidor[]

  @@index([pedidoId])
  @@map("pedido_items")
}

// ============================================================
// Rutas: jornada, camion y liquidacion
// ============================================================

/// Por que el cliente no acepto un producto. Es un catalogo cerrado porque de
/// el salen los reportes de devolucion: texto libre no se puede sumar.
enum MotivoDevolucion {
  NO_LO_QUISO
  DANADO
  SIN_QUIEN_RECIBA
  PRECIO_EQUIVOCADO
}

/// Un corte nace cerrado —el repartidor ya no lo toca salvo para corregir lo
/// declarado— y termina recibido por Finanzas. No existe un "corte abierto":
/// lo que hace de corte abierto es la sesion de entregas.
enum EstadoCorte {
  CERRADO
  RECIBIDO
}

/// La jornada de un repartidor: desde que pulsa "Inicio de entregas" hasta que
/// liquida. Es lo que agrupa lo que saco, lo que entrego y el dinero que trae.
///
/// **Un repartidor solo puede tener una sesion sin liquidar.** Lo garantiza un
/// indice unico parcial sobre `repartidorId WHERE corteId IS NULL`, escrito en
/// la migracion porque Prisma no sabe expresarlo. Sin el, dos pulsaciones
/// seguidas de "Inicio de entregas" abririan dos jornadas y la mercancia del
/// camion quedaria repartida entre las dos.
model SesionEntrega {
  id           String  @id @default(uuid())
  repartidorId String
  repartidor   Usuario @relation(fields: [repartidorId], references: [id])

  iniciadaEn DateTime @default(now())
  /// Se estampa al "Finalizar entregas" y vuelve a null si la reabre el mismo
  /// dia: mientras no haya corte es la misma jornada.
  finalizadaEn DateTime?

  /// Mientras es null la jornada sigue viva. Al liquidar queda atada a su corte.
  corteId String?
  corte   Corte?  @relation(fields: [corteId], references: [id])

  cargas CargaRepartidor[]

  @@index([repartidorId, iniciadaEn])
  @@map("sesiones_entrega")
}

/// Un renglon de lo que va en el camion: que producto, de que pedido, cuanto
/// subio, cuanto acepto el cliente y cuanto regresa.
///
/// Es el detalle fisico de la entrega, separado de `PedidoItem` porque un mismo
/// renglon del pedido puede salir a la calle varias veces: si no se entrega,
/// regresa a bodega en el corte y vuelve a salir otro dia con una fila nueva.
/// Por eso el historial de intentos se lee aqui y no en el pedido.
///
/// Un item no puede estar cargado dos veces a la vez: lo garantiza un indice
/// unico parcial sobre `pedidoItemId WHERE cerradoEn IS NULL`.
model CargaRepartidor {
  id String @id @default(uuid())

  sesionId String
  sesion   SesionEntrega @relation(fields: [sesionId], references: [id])

  repartidorId String
  repartidor   Usuario @relation(fields: [repartidorId], references: [id])

  pedidoId     String
  pedido       Pedido     @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  pedidoItemId String
  pedidoItem   PedidoItem @relation(fields: [pedidoItemId], references: [id], onDelete: Cascade)
  productoId   String
  producto     Producto   @relation(fields: [productoId], references: [id])

  /// Lo que subio al camion: siempre la cantidad entera del pedido.
  cantidadCargada Int
  /// Lo que el cliente acepto. Cero hasta que la entrega se cierra, asi que no
  /// significa "rechazado" mientras el pedido no este ENTREGADO.
  cantidadEntregada Int @default(0)
  /// `cargada - entregada`, escrito al cerrar el corte. Se guarda en vez de
  /// calcularse para que el renglon siga explicandose solo cuando el pedido
  /// vuelva a salir con otras cantidades.
  cantidadDevuelta Int @default(0)

  /// Precio congelado al recolectar (el del pedido).
  precioUnitario Decimal @db.Decimal(12, 2)
  /// Solo en entregas parciales: el precio re-cotizado al escalon de lo que el
  /// cliente si acepto. Null significa entrega completa, y entonces manda
  /// `precioUnitario`.
  precioEntregado Decimal? @db.Decimal(12, 2)

  motivoDevolucion MotivoDevolucion?

  /// Null mientras sigue en el camion.
  cerradoEn DateTime?
  creadoEn  DateTime  @default(now())

  @@index([pedidoId])
  @@index([sesionId])
  @@map("carga_repartidor")
}

/// La evidencia con la que se cierra una entrega a domicilio: foto, firma y
/// donde estaba el telefono al confirmarla.
///
/// Las imagenes no se guardan aqui sino en `imagenes` (carpeta `entregas`), y
/// esto solo apunta: una firma y una foto por entrega cabrian en la fila, pero
/// las traerian consigo en cada consulta de la pantalla de Rutas.
model EntregaPedido {
  /// Uno por pedido: es la entrega que lo cerro. Los intentos anteriores viven
  /// en `carga_repartidor` y en la bitacora.
  pedidoId String @id
  pedido   Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  repartidorId String
  repartidor   Usuario @relation(fields: [repartidorId], references: [id])

  fotoId  String?
  firmaId String?

  /// Opcional: si el cliente niega el permiso, la entrega no se frena por eso.
  lat Decimal? @db.Decimal(10, 7)
  lng Decimal? @db.Decimal(10, 7)

  creadoEn DateTime @default(now())

  @@map("entregas_pedido")
}

/// El cierre de caja y de camion de un repartidor: cuanto efectivo entrega,
/// que mercancia regresa y si Finanzas lo recibio.
model Corte {
  id           String  @id @default(uuid())
  repartidorId String
  repartidor   Usuario @relation("CortesDelRepartidor", fields: [repartidorId], references: [id])

  cerradoEn DateTime @default(now())

  /// Lo que dice el sistema que trae, por lo que entrego en efectivo.
  montoCalculado Decimal @db.Decimal(12, 2)
  /// Lo que el repartidor declara. Puede corregirlo mientras siga CERRADO.
  montoDeclarado Decimal @db.Decimal(12, 2)
  /// Lo que Finanzas conto al recibirlo. Null mientras no lo reciba.
  montoRecibido  Decimal? @db.Decimal(12, 2)

  recibidoEn    DateTime?
  recibidoPorId String?
  /// Quien lo recibe nunca puede ser quien lo cerro: se comprueba al recibir.
  recibidoPor   Usuario?  @relation("CortesRecibidos", fields: [recibidoPorId], references: [id])

  estado EstadoCorte @default(CERRADO)
  /// Novedades de la jornada, en texto libre.
  notas  String?

  pedidos  Pedido[]
  sesiones SesionEntrega[]
  abonos   CorteAbono[]

  @@index([estado, cerradoEn])
  @@map("cortes")
}

/// Lo que el repartidor entrega despues, cuando al recibir el corte falto
/// dinero. Van en filas aparte para no reescribir los montos del corte, que
/// quedan como fotografia de lo que paso ese dia.
model CorteAbono {
  id      String @id @default(uuid())
  corteId String
  corte   Corte  @relation(fields: [corteId], references: [id], onDelete: Cascade)

  monto Decimal @db.Decimal(12, 2)

  registradoPorId String
  registradoPor   Usuario @relation(fields: [registradoPorId], references: [id])

  nota     String?
  creadoEn DateTime @default(now())

  @@index([corteId])
  @@map("cortes_abonos")
}

// ============================================================
// Motor de cupones
// ============================================================

enum TipoDescuento {
  FIXED
  PERCENTAGE
}

enum EstadoCupon {
  ACTIVE
  USED
  EXPIRED
  CANCELLED
}

enum OrigenCupon {
  LIFECYCLE
  CAMPAIGN
}

enum TipoAudiencia {
  ALL
  NEW_CUSTOMERS
  EXISTING_CUSTOMERS
  SOURCE
  /// Declarado pero nunca califica: el programa de referidos esta fuera del SPEC 01.
  REFERRAL
  SEGMENT
}

enum TipoFuente {
  FACEBOOK
  INSTAGRAM
  INFLUENCER
  QR
  REFERIDO
  GOOGLE
  OTRO
}

/// Los 5 tipos fijos de ciclo de vida. El `code` no es editable; solo sus parametros.
model TipoCuponCicloVida {
  /// WELCOME | SECOND_PURCHASE | TICKET_INCREASE | INACTIVITY | BIRTHDAY
  code                  String        @id
  name                  String
  title                 String
  description           String
  customerMessage       String
  discountType          TipoDescuento
  discountValue         Decimal       @db.Decimal(12, 2)
  minimumOrderAmount    Decimal       @db.Decimal(12, 2)
  maximumOrderAmount    Decimal?      @db.Decimal(12, 2)
  validityDays          Int
  usageLimitPerCustomer Int

  /// Solo INACTIVITY.
  inactivityDays     Int?
  /// Solo BIRTHDAY.
  birthdayWindowDays Int?

  isActive      Boolean  @default(true)
  actualizadoEn DateTime @updatedAt

  @@map("cupones_ciclo_vida")
}

model Campania {
  id              String  @id @default(uuid())
  /// Nombre interno, no se repite entre campanias.
  name            String  @unique
  title           String
  description     String?
  customerMessage String?

  discountType       TipoDescuento
  discountValue      Decimal       @db.Decimal(12, 2)
  minimumOrderAmount Decimal       @db.Decimal(12, 2)
  maximumOrderAmount Decimal?      @db.Decimal(12, 2)

  startsAt DateTime?
  endsAt   DateTime?

  /// 0 = sin limite.
  usageLimitTotal       Int @default(0)
  usageLimitPerCustomer Int @default(1)

  targetType   TipoAudiencia @default(ALL)
  sourceCode   String?
  /// [{ attr, op, value }] — se combinan siempre con "Y".
  segmentRules Json          @default("[]")
  /// Vacio = sin restriccion de categoria.
  categorias   String[]

  isActive      Boolean  @default(true)
  creado        DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([isActive, startsAt, endsAt])
  @@map("campanias")
}

/// Cupon individual emitido a un cliente. Sus condiciones quedan "congeladas"
/// al momento de la emision (Word 5, regla 1).
model CuponEmitido {
  id   String @id @default(uuid())
  /// RPD + 4 caracteres de ABCDEFGHJKLMNPQRSTUVWXYZ23456789.
  code String @unique

  /// Dueno del cupon. Exactamente uno de los dos esta puesto: el cupon de
  /// bienvenida se emite antes de la primera compra, cuando todavia no hay
  /// `Cliente`, y cambia de columna al convertirse el prospecto.
  clienteId   String?
  cliente     Cliente?   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  prospectoId String?
  prospecto   Prospecto? @relation(fields: [prospectoId], references: [id], onDelete: Cascade)

  sourceKind OrigenCupon
  /// `code` del tipo de ciclo de vida, o `name` de la campania.
  sourceCode String

  title           String
  description     String?
  customerMessage String?

  // Congelados desde la plantilla al momento de emitir.
  discountType       TipoDescuento
  discountValue      Decimal       @db.Decimal(12, 2)
  minimumOrderAmount Decimal       @db.Decimal(12, 2)
  maximumOrderAmount Decimal?      @db.Decimal(12, 2)

  issuedAt  DateTime @default(now())
  expiresAt DateTime

  status          EstadoCupon @default(ACTIVE)
  usedAt          DateTime?
  /// Pedido en el que se canjeo. @unique = un cupon por pedido (Word 5, regla 2).
  usedPedidoId    String?     @unique
  usedPedido      Pedido?     @relation(fields: [usedPedidoId], references: [id])
  discountApplied Decimal?    @db.Decimal(12, 2)

  @@index([clienteId, status])
  @@index([prospectoId, status])
  @@index([sourceKind, sourceCode, status])
  @@index([status, expiresAt])
  @@map("cupones_emitidos")
}

model FuenteAdquisicion {
  id       String     @id @default(uuid())
  name     String
  type     TipoFuente @default(OTRO)
  code     String     @unique
  isActive Boolean    @default(true)
  creado   DateTime   @default(now())

  @@map("fuentes_adquisicion")
}

// ============================================================
// Configuracion y contenido
// ============================================================

/// Fila unica (id = 1) con toda la configuracion del negocio.
model ConfiguracionNegocio {
  id Int @id @default(1)

  // Horario de servicio
  /// {lun:true, mar:true, ..., dom:false}
  diasServicio    Json
  abre            String
  cierra          String
  atenderFuera    Boolean
  /// Porcentaje de incremento al atender fuera de horario.
  incrementoFuera Decimal @db.Decimal(5, 2)
  whatsappAyuda   String?

  // Parametros del negocio
  costoEnvio            Decimal @db.Decimal(12, 2)
  montoEnvioGratis      Decimal @db.Decimal(12, 2)
  multiplicadorCashback Decimal @db.Decimal(6, 2)
  montoMinimoCashback   Decimal @db.Decimal(12, 2)

  /// Si un pedido descuenta existencias.
  ///
  /// Nace apagado a proposito: al estrenar el modulo todos los productos estan
  /// en cero, y encenderlo antes de cargar la existencia real bloquearia todas
  /// las ventas. Mientras esta apagado, Inventario y Movimientos funcionan
  /// igual pero como bitacora: nadie deja de vender por un saldo que todavia
  /// no se ha capturado.
  controlInventario Boolean @default(false)

  // Datos bancarios
  banco        String?
  beneficiario String?
  numeroCuenta String?
  /// Para depositos en tienda de conveniencia (OXXO y similares).
  numeroTarjeta String?
  /// 18 digitos; es lo que pide una transferencia SPEI.
  clabe         String?

  actualizadoEn DateTime @updatedAt

  @@map("configuracion_negocio")
}

/// Niveles de fidelidad por gasto acumulado. Configurables desde Administracion:
/// los valores del seed son provisionales (ver Riesgos del SPEC 01).
model NivelFidelidad {
  id          String    @id @default(uuid())
  nombre      String    @unique
  umbralGasto Decimal   @db.Decimal(12, 2)
  orden       Int       @unique
  /// Cashback del nivel en puntos porcentuales: 1.5 = 1.5 % (HU-17).
  porcentaje  Decimal   @default(0) @db.Decimal(5, 2)
  clientes    Cliente[]

  @@map("niveles_fidelidad")
}

model MovimientoCashback {
  id        String   @id @default(uuid())
  clienteId String
  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  pedidoId  String?
  pedido    Pedido?  @relation(fields: [pedidoId], references: [id], onDelete: SetNull)
  monto     Decimal  @db.Decimal(12, 2)
  concepto  String
  creadoEn  DateTime @default(now())

  @@index([clienteId, creadoEn])
  @@map("movimientos_cashback")
}

model NoticiaDestacada {
  id          String   @id @default(uuid())
  badge       String
  titulo      String
  desc        String
  publicadoEn DateTime @default(now())

  @@index([publicadoEn])
  @@map("noticias_destacadas")
}

model Aviso {
  id          String   @id @default(uuid())
  icon        String
  titulo      String
  desc        String
  publicadoEn DateTime @default(now())

  @@index([publicadoEn])
  @@map("avisos")
}

/// Marca de agua del contador de no leidos de Destacados.
model LecturaDestacados {
  clienteId     String   @id
  cliente       Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  ultimaLectura DateTime

  @@map("lecturas_destacados")
}
