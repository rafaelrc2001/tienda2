# ---- Servidor ----
NODE_ENV=development
PORT=3000

# ---- Base de datos ----
# Local (docker-compose): postgresql://rapidix:rapidix@localhost:5432/rapidix?schema=public
# Railway: usa la DATABASE_URL que expone el plugin de Postgres
DATABASE_URL=postgresql://rapidix:rapidix@localhost:5432/rapidix?schema=public

# ---- CORS ----
# Orígenes que pueden llamar a la API, separados por comas. Sin la variable se
# asume desarrollo y solo se permite Vite en http://localhost:5173.
# En Railway: el dominio del servicio rapidix-web.
CORS_ORIGIN=http://localhost:5173

# ---- Enlaces públicos ----
# Base de los enlaces de fuentes de adquisición: <APP_PUBLIC_URL>/r/CODIGO
APP_PUBLIC_URL=https://rapidix.mx

# ---- Autenticación ----
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=7d

# Login de cliente sin WhatsApp. Con `true` la API no envía el OTP: lo
# devuelve en la respuesta de /auth/cliente/solicitar-codigo y el frontend
# entra sin enseñar la pantalla del código.
# Es para desarrollo y demos mientras WhatsApp está fuera de alcance (Word 8):
# encendido, cualquiera que sepa un teléfono entra como ese cliente.
# En producción déjalo en false.
AUTH_OTP_BYPASS=false

# Acceso directo por rol, sin credenciales. Con `true` la pantalla de login
# enseña los cinco modos del Word 2.4 y se entra tocando uno.
# Simula a n8n, que identificará al cliente por su WhatsApp antes de abrir la
# app. Mientras esté encendido cualquiera se firma un token de ADMINISTRADOR:
# es para probar los flujos, y en producción va en false.
AUTH_DEMO_LOGIN=false

# ---- Notificaciones ----
# Mientras no exista el proveedor real de WhatsApp (Word 8), el único envío
# posible es escribir en el log. Con `NODE_ENV=production` la API se niega a
# arrancar así; poner `true` acepta el riesgo a propósito para desplegar una
# demo: los códigos OTP quedan en los logs y quien los lea entra como
# cualquier cliente. En producción de verdad déjalo en false.
NOTIFICATIONS_ALLOW_CONSOLE=false

# ---- Administrador inicial (lo crea `prisma db seed`) ----
# En producción son obligatorias: el seed falla si no defines ADMIN_PASSWORD.
ADMIN_EMAIL=admin@rapidix.mx
ADMIN_PASSWORD=

# ---- Almacenamiento de imágenes ----
# Opcional. Con las seis variables puestas, el navegador sube las fotos
# directas a un bucket S3-compatible (Cloudflare R2 o AWS S3) y no pasan por la
# API. Es lo que conviene cuando haya volumen de imágenes.
#
# Sin ellas —o con solo algunas— la API guarda las fotos en la propia base de
# datos y las sirve por `GET /uploads/local/:id`. Funciona sin contratar nada,
# pero cada imagen ocupa espacio en Postgres.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Base de las URL de imagen que sirve la propia API. Normalmente no hace falta:
# se deduce de la petición, así que funciona en local y en Railway sin tocarla.
# Solo se declara si hay un dominio propio delante que la API no puede ver.
# API_PUBLIC_URL=https://api.rapidix.mx
